# ============================================================
# Contoh konfigurasi environment
# ============================================================
# Salin file ini menjadi `.env` untuk pengembangan lokal.
# `.env` TIDAK boleh di-commit (sudah di-ignore oleh .gitignore).

# ------------------------------------------------------------
# Mode demo
# ------------------------------------------------------------
# true  = aplikasi berjalan TANPA database (data demo disimpan di
#         memori server). Cocok untuk preview/pameran di Vercel.
# false = aplikasi memakai database Prisma (butuh DATABASE_URL).
#
# PENTING: variabel ini diawali NEXT_PUBLIC_ sehingga nilainya
# di-inline saat build. Nilai yang dipakai harus sama saat build.
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------------------------
# Database (WAJIB hanya bila NEXT_PUBLIC_DEMO_MODE=false)
# ------------------------------------------------------------
# Lokal (SQLite):
DATABASE_URL="file:./dev.db"
# Produksi (PostgreSQL, mis. Neon/Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ------------------------------------------------------------
# Autentikasi
# ------------------------------------------------------------
SESSION_COOKIE_NAME=Whenly_session
SESSION_TTL_DAYS=30

# ------------------------------------------------------------
# Aplikasi
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Whenly
TIMEZONE=Asia/Jakarta

# Provider billing. Biarkan "mock" pada prototype ini.
BILLING_PROVIDER=mock

# ------------------------------------------------------------
# Seed & verifikasi pelajar (hanya mode database)
# ------------------------------------------------------------
# Set "false" untuk melewati pembuatan akun demo saat seeding.
SEED_DEMO_DATA=true
# "demo" = simulasi; provider nyata belum diimplementasikan.
STUDENT_VERIFICATION_PROVIDER=demo
