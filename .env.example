# ============================================================
# Contoh konfigurasi environment
# ============================================================
# Salin file ini menjadi `.env` untuk pengembangan lokal.
# `.env` TIDAK boleh di-commit (sudah di-ignore oleh .gitignore).

# ------------------------------------------------------------
# Mode demo
# ------------------------------------------------------------
# true  = aplikasi berjalan TANPA database (data demo disimpan di
#         memori server). Cocok untuk preview/pameran di Vercel.
# false = aplikasi memakai database Prisma (butuh DATABASE_URL).
#
# PENTING: variabel ini diawali NEXT_PUBLIC_ sehingga nilainya
# di-inline saat build. Nilai yang dipakai harus sama saat build.
# false = memakai database PostgreSQL (Supabase). Ini mode yang dipakai
# pada deployment produksi.
NEXT_PUBLIC_DEMO_MODE=false

# ------------------------------------------------------------
# Database (WAJIB bila NEXT_PUBLIC_DEMO_MODE=false)
# ------------------------------------------------------------
# Produksi (PostgreSQL / Supabase):
# DATABASE_URL = koneksi pooler (port 6543) untuk runtime aplikasi
# DIRECT_URL   = koneksi langsung (port 5432) untuk prisma db push/migrate
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ------------------------------------------------------------
# Email pengingat (RESEND)
# ------------------------------------------------------------
# Buat API key gratis di https://resend.com → API Keys.
# Selama RESEND_API_KEY kosong, fitur email otomatis dinonaktifkan
# (bukan disimulasikan).
RESEND_API_KEY=
# Alamat pengirim. Untuk uji coba tanpa domain, Resend memakai:
REMINDER_FROM_EMAIL="Whenly <onboarding@resend.dev>"
# URL publik aplikasi, dipakai di dalam tautan email.
NEXT_PUBLIC_APP_URL="https://whenly-app.vercel.app"

# ------------------------------------------------------------
# Cron pengingat
# ------------------------------------------------------------
# String acak panjang. Vercel Cron mengirim header
# `Authorization: Bearer <CRON_SECRET>` secara otomatis.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ------------------------------------------------------------
# Autentikasi
# ------------------------------------------------------------
SESSION_COOKIE_NAME=Whenly_session
SESSION_TTL_DAYS=30

# ------------------------------------------------------------
# Aplikasi
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Whenly
TIMEZONE=Asia/Jakarta

# Provider billing. Biarkan "mock" pada prototype ini.
BILLING_PROVIDER=mock

# ------------------------------------------------------------
# Seed & verifikasi pelajar (hanya mode database)
# ------------------------------------------------------------
# Set "false" untuk melewati pembuatan akun demo saat seeding.
SEED_DEMO_DATA=true
# "demo" = simulasi; provider nyata belum diimplementasikan.
STUDENT_VERIFICATION_PROVIDER=demo
